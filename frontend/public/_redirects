# 2026-06-02 — void --news collapsed to a single daily feed.
# Old multi-edition URLs (/world, /us, /europe, /south-asia) 301-redirect
# to the homepage. Cloudflare Pages honors this file at the edge before
# any HTML is served.
/world      /  301
/world/*    /  301
/us         /  301
/us/*       /  301
/europe     /  301
/europe/*   /  301
/south-asia /  301
/south-asia/*  /  301

# 2026-08 — void --weekly is a single (world) issue now; the per-edition
# variants were never generated. 301 stray /weekly/europe + /weekly/south-asia
# links (and trailing-slash forms) to the current weekly instead of a 404.
/weekly/europe        /weekly  301
/weekly/europe/       /weekly  301
/weekly/south-asia    /weekly  301
/weekly/south-asia/   /weekly  301

# 2026-08 — void --ship is the full transparency board again (submit + Kanban).
# The board contains the submit form, so the old /feedback URL now lands on it.
/feedback    /ship                 301
/feedback/   /ship                 301

# 2026-08-03 — Revolt removed from prod (temporarily). 301 all /revolt* to home.
/revolt      /  301
/revolt/*    /  301

# Legacy GitHub Pages project-path. CF Pages serves at root, so 301 any
# stray /void--news/* deep link to the equivalent root path. Placed last:
# first match wins, so the specific edition rules above take precedence.
/void--news/*  /:splat  301
