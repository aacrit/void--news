[{"article": {"id": "002b4534-b7d1-458a-9768-d78d530231d9", "title": "John Ternus takes over as Apple enters era of AI, foldable phones", "url": "https://www.dawn.com/news/2026872/john-ternus-takes-over-as-apple-enters-era-of-ai-foldable-phones", "summary": "John Ternus took over as Apple’s chief executive on Tuesday, inheriting a company that towers over the smartphone market but trails its rivals inartificial intelligence.One of his biggest challenges will be balancing the company’s dependence on China while parrying acute political pressure from the White House.The handover endsTim Cook’s 15-year run, replacing the operations specialist who built Apple’s supply chain with the engineer who built its hardware.Ternus, 51, joined Apple’s design team in 2001 and worked his way up to senior vice president of hardware engineering, reporting to Cook.He leads the engineering teams behind Apple’s entire product lineup, including the iPhones that generate most of the company’s revenue.He gets barely a week to settle in, with Apple holding its annual iPhone event on September 9, where it is expected tounveilits first foldable handset.“Tim Cook left the house in phenomenal order,” said Dan Ives, partner and senior managing director at investment ...", "published_at": "2026-09-02T08:51:42+00:00", "image_url": "https://i.dawn.com/large/2026/09/02134027a1ba06e.webp", "source": {"name": "Dawn", "tier": "international", "url": "https://www.dawn.com"}, "bias_scores": [{"political_lean": 50, "sensationalism": 10, "opinion_fact": 25, "factual_rigor": 50, "framing": 20, "confidence": 0.7, "rationale": {"framing": {"connotation_score": 17.0, "keyword_emphasis_score": 0.0, "omission_score": 40.0, "headline_body_divergence": 38.4, "has_cluster_context": true}}}]}}, {"article": {"id": "08d80929-fa79-4299-94a4-3ec728c59043", "title": "Apple has a hardware guy as CEO. Here’s what people want him to do", "url": "https://www.fastcompany.com/91600895/john-ternus-ceo-hardware", "summary": "Apple’s new CEO John Ternus wrote“hello”in his first X post on Tuesday aftertaking the helm from former CEO Tim Cook, and his replies were immediately inundated with with requests for products andproduct designchanges. It makes sense.He’s a hardware guy.A mechanical engineer who previously oversaw Apple’s hardware engineering, Ternus has significantly shapedthe look and feel of Apple productsthat sell hundreds of millions of units cumulatively every year. For a company known for the elevated look and feel of its physical products, Ternus is uniquely positioned to bring Apple into a new era, hence the slew of unsolicited requests online when he got the job.Ternus graduated from the University of Pennsylvania with a degree in mechanical engineering and his only job before Apple was in VR. He worked as a mechanical engineer at the virtual reality hardware company Virtual Research Systems before joining Apple’s product design team in 2001. Ternus became Apple’s vice president of hardwar...", "published_at": "2026-09-03T14:30:00+00:00", "image_url": null, "source": {"name": "Fast Company", "tier": "independent", "url": "https://www.fastcompany.com"}, "bias_scores": [{"political_lean": 35, "sensationalism": 20, "opinion_fact": 32, "factual_rigor": 30, "framing": 20, "confidence": 0.49, "rationale": {"lean": {"keyword_score": 50.0, "framing_shift": 0.0, "entity_shift": 0.0, "sentence_direction": 0.0, "text_score": 50.0, "source_baseline": 35, "text_shift": 0.0, "delta_max": 10, "confidence": 1.0, "top_left_keywords": [], "top_right_keywords": [], "framing_phrases_found": [], "entity_sentiments": {}, "state_affiliated": false, "unscored": false}, "sensationalism": {"headline_score": 0.0, "body_score": 12.3, "clickbait_signals": 0, "superlative_density": 0.0, "urgency_density": 0.0, "hyperbole_density": 0.0, "measured_density": 0.0, "partisan_attack_density": 0.0}, "opinion": {"pronoun_score": 0.0, "subjectivity_score": 33.1, "modal_score": 0.0, "hedging_score": 0.0, "attributio