[{"article": {"id": "2a660ace-f4c0-4ac6-bff8-2c49b83a9ebb", "title": "Trump’s Lake Ontario name change clashes with a centuries-old treaty. Google Maps is on the hook, too", "url": "https://www.fastcompany.com/91598976/trump-lake-ontario-name-change-violates-centuries-old-treaty-google-maps-seneca-nation", "summary": "According to the president of the Seneca Nation, President Donald Trump’s executive order to rename Lake Ontario to Lake America is more than merely controversial: It flies in the face of a 232-year-old treaty—and social media thinks mapping platforms like Google Maps are just as guilty.Last week, Trump signed the executive order, directing the Interior Department to change the name of Lake Ontario to Lake America. It’s an apparent step in his ongoing trade fight with Canada. Earlier in August, the United States imposed 50% tariffs on hundreds of Canadian goods, which prompted Canada to do the same, with 50% tariffs on U.S. goods set to go into effect in September.Before signing the order, Trumpposted on Truth Socialthat the U.S. was considering changing the name of the lake as “we don’t expect to be doing much business with Ontario any longer.”But what Trump saw as a dig toward Canada ignores the origins of the word Ontario, which far predate the name of any province, lake, or mode...", "published_at": "2026-09-01T13:45:00+00:00", "image_url": null, "source": {"name": "Fast Company", "tier": "independent", "url": "https://www.fastcompany.com"}, "bias_scores": [{"political_lean": 50, "sensationalism": 10, "opinion_fact": 25, "factual_rigor": 50, "framing": 29, "confidence": 0.7, "rationale": {"framing": {"connotation_score": 36.5, "keyword_emphasis_score": 0.0, "omission_score": 40.0, "headline_body_divergence": 56.3, "has_cluster_context": true}}}]}}, {"article": {"id": "3c750b7a-3e91-4f8d-b2b5-81e35ba81c02", "title": "Apple Maps changes name of Lake Ontario to 'Lake America' for US users", "url": "https://www.dawn.com/news/2026843/apple-maps-changes-name-of-lake-ontario-to-lake-america-for-us-users", "summary": "Apple changed the name of Lake Ontario to “Lake America” on the web version of its Apple Maps following US President Donald Trump’s executive orderrenamingthe lake.The move by Apple on Tuesday followed adecision by Alphabetlate on Saturday to change the name of the lake on its Google Maps for US users.Apple confirmed that US users will see Lake America following a change to the body of water’s name in the US Geographic Names Information System (GNIS).Users in Canada will continue to see Lake Ontario, and users in the rest of the world will see both names, following the same approach Apple used after Trumprenamedthe Gulf of Mexico as the Gulf of America.The name changes illustrate how US tech companies are being pulled into geopolitical disputes as the Trump administration pressures them to comply with executive orders that allies and international bodies have rejected.Trump’s executive order on Lake Ontario, one of the five Great Lakes of North America, applies to US federal usage f...", "published_at": "2026-09-02T07:03:33+00:00", "image_url": "https://i.dawn.com/large/2026/09/02113022d0ea189.webp", "source": {"name": "Dawn", "tier": "international", "url": "https://www.dawn.com"}, "bias_scores": [{"political_lean": 48, "sensationalism": 12, "opinion_fact": 18, "factual_rigor": 60, "framing": 21, "confidence": 0.56, "rationale": {"lean": {"keyword_score": 50.0, "framing_shift": 0.0, "entity_shift": -1.7, "sentence_direction": 0.0, "text_score": 48.3, "source_baseline": 50, "text_shift": -1.7, "delta_max": 24, "confidence": 1.0, "top_left_keywords": [], "top_right_keywords": [], "framing_phrases_found": [], "entity_sentiments": {"donald trump": 0.05, "trump": 0.08, "democrat": 0.25}, "state_affiliated": false, "unscored": true}, "sensationalism": {"headline_score": 0.0, "body_score": 10.0, "clickbait_signals": 0, "superlative_density": 0.0, "urgency_density": 0.0, "hyperbole_density": 0.0, "measured_den