[{"article": {"id": "0353ad58-1a2a-4096-8f51-9fe462cc1211", "title": "NPCI International and Uzbekistan’s NIPC partner to enable UPI payments across Uzbekistan via UZQR", "url": "https://www.greaterkashmir.com/national/npci-international-and-uzbekistans-nipc-partner-to-enable-upi-payments-across-uzbekistan-via-uzqr-12460202", "summary": "New Delhi, Aug 31:NPCI International Payments Ltd. (NIPL), the international arm of the National Payments Corporation of India (NPCI), has entered into a commercial agreement with the National Interbank Processing Centre JSC (NIPC), operator of Uzbekistan’s national payment system, HUMO, on 30th August 2026. The partnership enables Indian travellers to scan Uzbekistan’s national interoperable QR code UZQR using their familiar UPI-enabled applications to make instant merchant payments across the country.The announcement was made during the bilateral visit of the Prime Minister of India to Uzbekistan. The execution of the agreement follows formal approvals from financial regulators, including the Reserve Bank of India (RBI) and the Central Bank of Uzbekistan (CBU), which designated HUMO as NIPL’s authorised partner for cross-border merchant acceptance.Key Highlights of the AgreementUniversal Merchant Acceptance: By integrating with CBU’s mandated Unified National QR infrastructure (UZ...", "published_at": "2026-08-31T15:37:58+00:00", "image_url": "https://img-cdn.publive.online/fit-in/1200x675/greater-kashmir/media/media_files/2026/08/26/upi-2026-08-26-06-09-27.jpg", "source": {"name": "Greater Kashmir", "tier": "independent", "url": "https://www.greaterkashmir.com"}, "bias_scores": [{"political_lean": 35, "sensationalism": 17, "opinion_fact": 20, "factual_rigor": 10, "framing": 17, "confidence": 0.61, "rationale": {"lean": {"keyword_score": 50.0, "framing_shift": 0.0, "entity_shift": 0.0, "sentence_direction": 0.0, "text_score": 50.0, "source_baseline": 35, "text_shift": 0.0, "delta_max": 10, "confidence": 1.0, "top_left_keywords": [