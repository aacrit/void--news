[{"article": {"id": "097017c4-20cd-43c3-af14-5a7385220b44", "title": "It’s Time for Our Own Gloria Days", "url": "https://washingtonmonthly.com/2026/09/04/its-time-for-our-own-gloria-days/", "summary": "Gloria Steinem, the feminist icon, author, activist, and organizer is dead at 92, leaving those of us in the women’s rights movement mournful—and determined.The postIt’s Time for Our Own Gloria Daysappeared first onWashington Monthly.", "published_at": "2026-09-04T09:00:00+00:00", "image_url": "https://i0.wp.com/washingtonmonthly.com/wp-content/uploads/2026/09/AP26246767581068-scaled.jpg?fit=2560%2C1706&ssl=1", "source": {"name": "Washington Monthly", "tier": "independent", "url": "https://washingtonmonthly.com"}, "bias_scores": [{"political_lean": 50, "sensationalism": 10, "opinion_fact": 25, "factual_rigor": 50, "framing": 27, "confidence": 0.7, "rationale": {"framing": {"connotation_score": 29.5, "keyword_emphasis_score": 0.0, "omission_score": 40.0, "headline_body_divergence": 55.5, "has_cluster_context": true}}}]}}, {"article": {"id": "5778e144-0d46-4425-9af2-c102b21b297f", "title": "For Gloria Steinem, fashion was about much more than aesthetics", "url": "https://www.theguardian.com/world/2026/sep/04/gloria-steinem-fashion-feminism-aesthetics", "summary": "In an era when feminists were stereotyped as unattractive, the pioneering writer’s style created a Trojan horseGloria Steinem obituaryGloria Steinem: A life in picturesWhen people wanted to dismiss Gloria Steinem, they spoke about how she looked. Talking about the pioneering activist and journalist who turned feminism into a major civil rights movement, it might seem reductive to focus on her glasses.But after Steinem –whose death at 92 was announced on Thursday– wore them on the cover of Newsweek in 1971 next to the cover-line The New Woman, the lightly tinted aviators – often worn over her hair – became an accidental form of self-branding that made her instantly recognisable. They were as indelibly linked t