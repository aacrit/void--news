[{"article": {"id": "7c6aa49a-091f-4e3a-a59c-040e84ff6e47", "title": "Imran's hospital transfer: PTI resubmits contempt plea after SC raises objections", "url": "https://www.dawn.com/news/2025198/imrans-hospital-transfer-pti-resubmits-contempt-plea-after-sc-raises-objections", "summary": "ISLAMABAD: The PTI on Tuesday resubmitted a contempt of court petition by PTI founder Imran Khan’s sister to the Supreme Court (SC) against the alleged violation of its August 18 order for the ex-premier’s transfer to a private hospital.Later, Imran’s sister Uzma Khan also filed an application for the early hearing of the contempt petition.The contempt plea was re-submitted shortly after the SC returned it after raising certain objections.PTI Chairman Barrister Gohar Ali Khan said that the SC registrar had informed him that the petition was being returned, with one of the objections being that the list of charges levelled against the respondents had not been dispatched. He had also said that the PTI was going to resubmit the petition after removing the objections raised.Last week, Imran’s sister Uzma Khan hadfileda petition before the SC against authorities for violating the court’s Aug 18 order. In its order, the court hadorderedthe government to shift Imran to Shifa International ...", "published_at": "2026-08-25 10:13:43+00", "image_url": "https://i.dawn.com/large/2026/08/251240272054643.webp", "source": {"name": "Dawn", "tier": "international", "url": "https://www.dawn.com"}, "bias_scores": [{"political_lean": 50, "sensationalism": 9, "opinion_fact": 8, "factual_rigor": 67, "framing": 13, "confidence": 0.73, "rationale": "\"{\\\"lean\\\": {\\\"keyword_score\\\": 50.0, \\\"framing_shift\\\": 0.0, \\\"entity_shift\\\": 0.0, \\\"sentence_direction\\\": 0.0, \\\"text_score\\\": 50.0, \\\"source_baseline\\\": 50, \\\"text_shift\\\": 0.0, \\\"delta_max\\\": 24, \\\"confidence\\\": 1.0, \\\"top_left_keywords\\\": [], \\\"top_right_keywords\\\": [], \\\"framing_phrases_found\\\": [], \