[{"article": {"id": "ca0fb3d7-d56d-48b3-a93b-e45176fa380b", "title": "Jaishankar meets Russian President Putin; discusses bilateral ties, global developments", "url": "https://www.greaterkashmir.com/world/jaishankar-meets-russian-president-putin-discusses-bilateral-ties-global-developments-12429797", "summary": "External Affairs Minister S Jaishankar on Monday called on Russian President Vladimir Putin, as the two sides discussed bilateral ties and global developments.Jaishankar, who arrived in Moscow on Sunday, is on a two-day visit to Russia.It comes ahead of Putin’s expected visit to New Delhi for the BRICS leaders’ summit on September 12-13. The meeting assumes significance as India and Russia seek to deepen their economic engagement and expand cooperation in a range of areas.Earlier in the day, the foreign minister held talks with Russian First Deputy Prime Minister Denis Manturov on ways to further expand bilateral trade and economic cooperation.“The India-Russia partnership has consistently demonstrated resilience and adaptability,” Jaishankar said at an event which he co-chaired with Manturov. “Even amidst a complex international landscape, our engagement has continued to deepen, reflecting the mutual interest and confidence that define our bilateral partnership.”During his visit, J...", "published_at": "2026-08-25 01:47:53+00", "image_url": "https://img-cdn.publive.online/fit-in/1200x675/greater-kashmir/media/media_files/2026/08/25/jaishankar-meets-russian-president-putin-2026-08-25-07-17-20.png", "source": {"name": "Greater Kashmir", "tier": "independent", "url": "https://www.greaterkashmir.com"}, "bias_scores": [{"political_lean": 35, "sensationalism": 13, "opinion_fact": 17, "factual_rigor": 51, "framing": 17, "confidence": 0.54, "rationale": "\"{\\\"lean\\\": {\\\"keyword_score\\\": 50.0, \\\"framing_shift\\\": 0.0, \\\"entity_shift\\\": 0.0, \\\"sentence_direction\\\": 0.0, \\\"text_score\\\": 50.0, \\\"source_baseline\\\": 35, \\\"text_shift\\\": 0.0,