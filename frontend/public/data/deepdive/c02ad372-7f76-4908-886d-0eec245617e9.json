;]", "published_at": "2026-09-18T15:41:04+00:00", "image_url": "https://www.motherjones.com/wp-content/uploads/2026/09/GettyImages-2295088964-e1789744155931.jpg?w=1200&h=630&crop=1", "source": {"name": "Mother Jones", "tier": "us_major", "url": "https://www.motherjones.com"}, "bias_scores": [{"political_lean": 21, "sensationalism": 14, "opinion_fact": 12, "factual_rigor": 44, "framing": 22, "confidence": 0.76, "rationale": {"lean": {"keyword_score": 50.0, "framing_shift": 0.0, "entity_shift": 1.0, "sentence_direction": 0.0, "text_score": 51.0, "source_baseline": 20, "text_shift": 1.0, "delta_max": 10, "confidence": 1.0, "top_left_keywords": [], "top_right_keywords": [], "framing_phrases_found": [], "entity_sentiments": {"trump": 0.12, "donald trump": -0.05}, "state_affiliated": false, "unscored": false}, "sensationalism": {"headline_score": 2.0, "body_score": 10.1, "clickbait_signals": 0, "superlative_density": 0.39, "urgency_density": 0.0, "hyperbole_density": 0.0, "measured_density": 0.0, "partisan_attack_density": 0.0}, "opinion": {"pronoun_score": 0.0, "subjectivity_score": 24.9, "modal_score": 2.5, "hedging_score": 0.0, "attribution_score": 43.6, "metadata_score": 0.0, "value_judgment_score": 0.0, "absolutist_assertion_score": 3.8, "classification": "Reporting", "dominant_signals": ["attribution_gaps", "subjectivity", "absolutist_assertions"]}, "coverage": {"named_sources_count": 1, "org_citations_count": 1, "data_points_count": 4, "direct_quotes_count": 13, "vague_sources_count": 0, "specificity_ratio": 1.0}, "framing": {"connotation_score": 42.5, "keyword_emphasis_score": 1.9, "omission_score": 40.0, "headline_body_divergence": 18.8, "has_cluster_context": true}}}]}}, {"article": {"id": "d53b697e-f29f-4984-bf52-0516df08916d", "title": "Kennedy Center shutdown covering up bigger mess triggered by Trump: lawyer", "url": "https://www.rawstory.com/trump-kennedy-center-2677890204/", "summary": "The push to shut down theKennedy Centeris a cover story meant to hide 