[{"article": {"id": "157bd450-cc0e-411d-aa9e-3de77cba3009", "title": "Brent jumps 3% to above $90 after flare-up in U.S.-Iran hostilities", "url": "https://www.cnbc.com/2026/08/31/oil-prices-hormuz-iran-larak-island-centcom.html", "summary": "Oil prices moved higher Monday, after the U.S. struck Iranian targets for the first time in weeks.", "published_at": "2026-08-31T12:33:57+00:00", "image_url": "https://image.cnbcfm.com/api/v1/image/108347819-1786452008208-gettyimages-2289371437-AFP_C4CF39M.jpeg?v=1786452035&w=1920&h=1080", "source": {"name": "CNBC", "tier": "us_major", "url": "https://www.cnbc.com"}, "bias_scores": [{"political_lean": 50, "sensationalism": 10, "opinion_fact": 25, "factual_rigor": 50, "framing": 8, "confidence": 0.7, "rationale": {"framing": {"connotation_score": 0.0, "keyword_emphasis_score": 0.0, "omission_score": 40.0, "headline_body_divergence": 6.5, "has_cluster_context": true}}}]}}, {"article": {"id": "1b116354-13bb-44da-a4db-214ca80e5b9a", "title": "Wall St slips as higher oil prices, hawkish Fed bets weigh", "url": "https://www.brecorder.com/news/40437251/wall-st-slips-as-higher-oil-prices-hawkish-fed-bets-weigh", "summary": "The main U.S. stock indexesdropped on Monday after military strikes between the United States and Iran drove up oil prices, fanning inflation worries after Fed Chair Kevin Warsh’s hawkish remarks in his first Jackson Hole address the previous week.The losses could set the tone for September, typically a weak month for equities, and are likely to up the ante at the U.S. Federal Reserve’s meeting next month.Traders see a more than 60% chance of a rate hike at the Fed’s September meeting, according to CME’s FedWatch, a sharp increase from 41.4% a week ago, after Warsh said policymakers may need to increase borrowing costs if inflation does not ease to the central bank’s 2% target.“He (Warsh) took any chance of a (rate) cut off the table,” said Thomas Kikis, head of markets, U.S. and Americas, at Standard Chartered.Warsh’s comments, delivered on Friday at the Fed’s Jackson Hole symposium, came after mixed data in recent weeks.A consumer inflation report this month showed price pressures...", "published_at": "2026-08-31T14:41:51+00:00", "image_url": "https://i.brecorder.com/large/2026/08/3119413147552e2.webp", "source": {"name": "Business Recorder", "tier": "international", "url": "https://www.brecorder.com"}, "bias_scores": [{"political_lean": 50, "sensationalism": 10, "opinion_fact": 25, "factual_rigor": 50, "framing": 17, "confidence": 0.7, "rationale": {"framing": {"connotation_score": 27.1, "keyword_emphasis_score": 0.0, "omission_score": 40.0, "headline_body_divergence": 16.3, "has_cluster_context": true}}}]}}, {"article": {"id": "21050c01-dd36-459a-a839-2986bdbfff32", "title": "Oil prices jump amid resumption of US-Iran clashes", "url": "https://www.middleeasteye.net/live-blog/live-blog-update/oil-prices-jump-amid-resumption-us-iran-clashes", "summary": "Oil prices jump amid resumption of US-Iran clashesCrude oil prices rose on Monday after the US attacked Iran's Larak Island, prompting Iran to retaliate in the first open fire between the two countries since July.Brent crude prices jumped over 2.5% on Monday alone, taking prices to $90.34 per barrel.The US-Israeli assault has caused oil prices to spike amid Iran's closure of the vital strait of Hormuz shipping lane, although prices are now far lower than at the height of hostilities earlier this year, when crude traded at upwards of $110 per barrel.", "published_at": "2026-08-31T18:25:40+00:00", "image_url": "https://www.middleeasteye.net/sites/default/files/2026-08/Vessels%20in%20the%20Strait%20of%20Hormuz%20are%20visible%20near%20the%20beach%20of%20Bandar%20Abbas%20Iran%2028%20august%202026%20retuers.jpg", "source": {"name": "Middle East Eye", "tier": "international", "url": "https://www.middleeasteye.net"}, "bias_scores": [{"political_lean": 50, "sensationalism": 10, "opinion_fact": 25, "factual_rigor": 50, "framing": 24,